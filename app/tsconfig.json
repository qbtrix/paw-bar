{
  "//": "Created 2026-07-15 (A3): app TS config scoped to app/src + app/tests. Bundler resolution + strict. 2026-09-27: the root tsconfig and the vanilla widget it covered were removed; this config was always separate from them.",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client", "vitest/globals"]
  },
  "include": ["src", "tests", "vite.config.ts", "svelte.config.js"]
}
